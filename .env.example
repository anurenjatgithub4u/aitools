# Server-only. Used by /api/brainstorm and /api/localize. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional: override the model used for brainstorm/localize.
# OPENAI_MODEL=
# Optional: Google Analytics 4 measurement id (G-XXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=

# Optional: SQLite file location (default ./data/app.db)
# DATABASE_PATH=
# Optional: iTunes rate limit (requests/minute, default 15) and cache TTL in minutes (default 60, 0 disables)
# ITUNES_RPM=15
# ITUNES_CACHE_TTL_MINUTES=60

# --- Hosting (Vercel) ---
# Shared password for the whole site. Unset = no login (fine on your own machine).
# APP_PASSWORD=
# Turso database. The Vercel Turso integration sets these; unset = local ./data/app.db.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
