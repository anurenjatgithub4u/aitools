# Server-only. Used by /api/brainstorm and /api/localize. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional: override the model used for brainstorm/localize.
# OPENAI_MODEL=
# Optional: Google Analytics 4 measurement id (G-XXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=

# Optional: SQLite file location (default ./data/app.db)
# DATABASE_PATH=
# Optional: iTunes rate limit (requests/minute, default 15) and cache TTL in minutes (default 360)
# ITUNES_RPM=15
# ITUNES_CACHE_TTL_MINUTES=360
