# Server-only. Used by /api/brainstorm and /api/localize. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional: override the model used for brainstorm/localize.
# OPENAI_MODEL=
# Optional: Google Analytics 4 measurement id (G-XXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=

# Optional: SQLite file location (default ./data/app.db)
# DATABASE_PATH=
# Optional: iTunes rate limit (requests/minute, default 15) and cache TTL in minutes (default 60, 0 disables)
# ITUNES_RPM=15
# ITUNES_CACHE_TTL_MINUTES=60

# --- Accounts (Firebase Auth) ---
# Leave all of these empty for local mode: no sign-in, every project belongs to "local".
# Web config (public by design): Firebase console → Project settings → General → Your apps → Web app.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=     (your-project.firebaseapp.com)
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Server secret: Project settings → Service accounts → Generate new private key (a JSON file).
# Copy its client_email and private_key. Never NEXT_PUBLIC_.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Hosting (Vercel) ---
# Turso database. The Vercel Turso integration sets these; unset = local ./data/app.db.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=          (Vercel's integration names it TURSO_DATABASE_TURSO_AUTH_TOKEN; either works)
